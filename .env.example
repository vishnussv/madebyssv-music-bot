# MADEBYSSV Music Bot — environment variables
# Copy this file to .env and fill in your own values.
# NEVER paste your bot token in chat, in a ticket, or in a public repo.
# NEVER commit the real .env file.

# --- Required ---
# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord user ID (Developer Mode -> right-click yourself -> Copy User ID).
# This is the ONLY main owner. Owner-only commands refuse when this is empty.
MAIN_OWNER_ID=

# Extra owner user IDs, comma-separated (optional).
OWNER_IDS=

# --- Lavalink (required for music) ---
# Host of your Lavalink server (no protocol needed, e.g. lavalink.example.com).
# Free options: run Lavalink yourself, or use a free hosted Lavalink node.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
# true / false / auto — auto picks TLS when the port is 443 or the host has wss/https.
LAVALINK_SECURE=auto
# Optional extra nodes: "wss://host:443|password,host:2333|password"
# LAVALINK_NODES=

# --- Optional ---
# Default command prefix (per-server prefixes set with +setprefix override it).
PREFIX=+
# Embed colour as hex (MADEBYSSV blue by default).
EMBED_COLOR=00D4FF
# Public links shown by +support / +website / +vote (leave blank to hide).
SUPPORT_SERVER=
WEBSITE_URL=
VOTE_URL=
# Genius API key for +lyrics (optional — lyrics fall back to other sources).
GENIUS_API_KEY=

# --- Optional webhook logging (Discord webhook URLs) ---
# WEBHOOK_DEFAULT=
# WEBHOOK_COMMANDS=
# WEBHOOK_MUSIC=
# WEBHOOK_ERRORS=
# WEBHOOK_JOINS=
# WEBHOOK_OWNERS=
# WEBHOOK_MAINLOGS=

# --- Live dashboard API (optional, off by default) ---
# The dashboard page is a separate static page that talks to the bot over
# this HTTP API. It cannot control Discord without this API running and
# reachable.
# RAILWAY / SHARED PORT: the API is served on the bot's main keep-alive
# HTTP server (process.env.PORT — the only port Railway exposes publicly),
# so it is reachable at the SAME public URL as the bot service, e.g.
# https://<your-railway-domain>/api/status — no separate port 3001 is
# needed or reachable in production. DASHBOARD_PORT below is only for
# local standalone use (startDashboard on its own port), or set
# DASHBOARD_SEPARATE_PORT=true to use it instead of the shared port.
# DASHBOARD_ENABLED=true to start it. Only shard 0 serves it.
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3001
# DASHBOARD_SEPARATE_PORT=false  # true = own port 3001 (local only); false/absent = shared main port (Railway)
# Long random key for the dashboard. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The dashboard page must send it as header X-Dashboard-Key on every
# /api/* request. NEVER commit it, never share it publicly — anyone with
# this key can control music in any server the bot is in. If it leaks,
# generate a new one and update the dashboard. The API refuses to start
# if this is empty.
DASHBOARD_API_KEY=
ENABLE_PRIVILEGED_INTENTS=false  # only set true after enabling Message Content + Server Members intents in Discord Developer Portal
