# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets — never commit these
.env
.env.local
.env.*.local

# Runtime state (guild/user data created while the bot runs).
# The clean empty template files are shipped in the release zip; live data
# stays out of git.
data/*.json
database/*.json
!data/.gitkeep
!database/.gitkeep

# SQLite (Poru music features: favourites / playlists / 24/7)
*.db
*.sqlite
*.sqlite3
*.sqlite-journal

# Logs and OS files
*.log
logs/
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
